.DS_Store
*.log

# design reference images (stay out of deploy)
ChatGPT*.png
reference*.png
*.psd
*.fig

# if ever added locally
node_modules/

# secrets — токены соцсетей, никогда не коммитим
.env

# рабочие материалы и доступы: лежат рядом с проектом, но в репозиторий
# не идут. Без этих строк `git add -A` утаскивает их одним движением.
ключи/
сео/
/*.csv
/*.docx
/*.xlsx

# ключи сервисных аккаунтов Google — им место в ~/.config/macmagia/,
# а не в проекте: отсюда файл уезжает и в репозиторий, и на сервер
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*.json
*service-account*.json
*credentials*.json
gsc*.json
.wordstat-profile/

# Собранные страницы блога.
# Деплой сам запускает scripts/build_blog.py перед выгрузкой, поэтому в
# репозитории они не нужны — а коммитились при каждой правке и раздули .git
# до 43 ГБ (650 файлов × сотни коммитов).
# Обложки (blog/covers) и пины (blog/pins) рисуются локально и остаются в git.
# sitemap.xml и blog/rss.xml тоже остаются: сборка читает существующий
# sitemap.xml, а не создаёт с нуля, и на чистом клоне без него падает.
blog/*.html
blog/*/*.html
